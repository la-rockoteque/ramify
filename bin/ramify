#!/usr/bin/env bash
# ramify — the Rust binary is the CLI. Build it once if it is missing.
set -uo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
RAMIFY_HOME="$(cd "$(dirname "$src")/.." && pwd)"
bin="$RAMIFY_HOME/cli/target/release/ramify"
if [ ! -x "$bin" ] && [ -x "$RAMIFY_HOME/cli/target/debug/ramify" ]; then
  bin="$RAMIFY_HOME/cli/target/debug/ramify"
fi
if [ ! -x "$bin" ]; then
  command -v cargo >/dev/null 2>&1 \
    || { echo "ramify: the Rust binary is not built — run: cargo build --release --manifest-path \"$RAMIFY_HOME/cli/Cargo.toml\"" >&2; exit 1; }
  cargo build --release --quiet --manifest-path "$RAMIFY_HOME/cli/Cargo.toml" >&2 || exit 1
  bin="$RAMIFY_HOME/cli/target/release/ramify"
fi
exec "$bin" "$@"
