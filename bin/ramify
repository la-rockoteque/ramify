#!/usr/bin/env bash
# ramify — one branch per worktree, one QA stack per worktree, many at once.
#
# Usage:  ramify setup [--print | --force] [--local] | config [-q | get VAR]
#         ramify new <slug> | label [slug]
#         ramify up | down | ping | card | dash [--json] | watch [seconds] | status | shared-down
#         ramify cleanup | prune [--apply] | delete <worktree> [--yes] | complete <worktree> [--yes]
#         ramify jira login | check | statusline [--json] | app
#         ramify write-set <file> | write-set --self-test
#
# THE CONTAINERS ARE SHARED AND THE APPS ARE NOT. Databases and emulators are expensive, stateful
# and identical for every branch, so they run once under a fixed compose project. The services a
# branch changes run per worktree, on a numbered port slot from a machine-wide registry.
set -uo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
RAMIFY_HOME="$(cd "$(dirname "$src")/.." && pwd)"
SELF="$RAMIFY_HOME/bin/ramify"

die() { echo "ramify: $*" >&2; exit 1; }

# `RAMIFY_ROOT` wins over the working directory: hooks run from the session's project directory,
# not from the worktree under test, and a `down` aimed at the wrong tree kills nothing and
# reports success.
REPO_ROOT="${RAMIFY_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null)}"
# Every configured repo on the machine, one primary checkout per line. It lives with the user's
# Claude config, not in /tmp: the app lists a repo whose stacks are all down, and a reboot
# empties /tmp.
REGISTRY="${RAMIFY_REGISTRY:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/ramify/projects}"
# The dashboard is machine-wide, so it runs from anywhere: outside a checkout, borrow any project.
case "${1:-}" in dash|watch)
  [ -n "$REPO_ROOT" ] || REPO_ROOT="$(cat "$REGISTRY" "${RAMIFY_STATE_DIR:-/tmp/ramify}"/*/primary 2>/dev/null \
    | while read -r p; do [ -d "$p" ] && { echo "$p"; break; }; done)"
  [ -n "$REPO_ROOT" ] || { echo "no ramify project on this machine yet — 'ramify setup' in a repo, then 'ramify up'"; exit 0; } ;;
esac
case "${1:-}" in ''|-h|--help|help) sed -n '3,8p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
case "${1:-}" in write-set) exec "$RAMIFY_HOME/libexec/write-set.sh" "${@:2}" ;; esac
# The app is machine-wide like the dashboard: it runs from anywhere.
case "${1:-}" in app) exec "$RAMIFY_HOME/libexec/app.sh" ;; esac
# The status line runs outside any checkout, many times a minute: its own script, no config load.
case "${1:-}" in statusline) exec "$RAMIFY_HOME/libexec/statusline.sh" "${@:2}" ;; esac
[ -n "$REPO_ROOT" ] || die "not inside a git checkout (or set RAMIFY_ROOT)"
PRIMARY="$(git -C "$REPO_ROOT" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')"
[ -n "$PRIMARY" ] || die "$REPO_ROOT is not a git checkout"
WORKTREE="$(basename "$REPO_ROOT")"

CONFIG=""
for d in "$REPO_ROOT" "$PRIMARY"; do
  for f in .ramify.conf .claude/ramify.conf; do
    [ -f "$d/$f" ] && { CONFIG="$d/$f"; break 2; }
  done
done
# shellcheck disable=SC1090
[ -n "$CONFIG" ] && . "$CONFIG"

: "${RAMIFY_PROJECT:=$(basename "$PRIMARY")}"
: "${RAMIFY_REMOTE:=origin}"
: "${RAMIFY_MAIN:=main}"
: "${RAMIFY_WORKTREES:=../$(basename "$PRIMARY")-wt}"
: "${RAMIFY_BRANCH_PREFIX:=}"
: "${RAMIFY_COPY:=}"
: "${RAMIFY_COPY_EXCLUDE:=worktrees/}"
: "${RAMIFY_BOOTSTRAP:=}"
: "${RAMIFY_READY:=}"
: "${RAMIFY_COMPOSE_FILE:=}"
: "${RAMIFY_COMPOSE_PROJECT:=$RAMIFY_PROJECT}"
: "${RAMIFY_CONTAINERS:=}"
: "${RAMIFY_SERVICES:=}"
: "${RAMIFY_MAX_SLOT:=3}"
: "${RAMIFY_SKIP:=}"
: "${RAMIFY_QA_PLAN:=}"
: "${RAMIFY_QA_RESULTS:=}"
: "${RAMIFY_QA_NOTES:=}"
: "${RAMIFY_JIRA_URL:=}"
: "${RAMIFY_JIRA_DONE:=}"
: "${RAMIFY_TICKET_PATTERN:=[A-Za-z][A-Za-z0-9]*-[0-9]+}"

# A fixed /tmp, not $TMPDIR: a sandboxed agent shell and a hook see different $TMPDIRs, and the
# registry only works if every session on the machine reads the same one.
STATE_ROOT="${RAMIFY_STATE_DIR:-/tmp/ramify}"
STATE_DIR="$STATE_ROOT/$RAMIFY_PROJECT"
SLOTS="$STATE_DIR/slots"
STATE="$STATE_DIR/$WORKTREE.env"
# Why the last `up` failed, one `service<TAB>log<TAB>message` per line. `up` starts it afresh,
# `down` clears it; the app draws a "!" per line.
ERRORS="$STATE_DIR/$WORKTREE.errors"
# Each configured project records its primary checkout, so `dash` and the app find every project.
# An appended line is one write: two sessions registering at once leave a duplicate, not a mix.
if [ -n "$CONFIG" ]; then
  mkdir -p "$SLOTS" "$STATE_DIR/shared"
  printf '%s\n' "$PRIMARY" >"$STATE_DIR/primary"
  grep -qxF "$PRIMARY" "$REGISTRY" 2>/dev/null \
    || { mkdir -p "$(dirname "$REGISTRY")" && printf '%s\n' "$PRIMARY" >>"$REGISTRY"; } 2>/dev/null
fi

# ── Config access ────────────────────────────────────────────────────────────
sv() { local n="${1}_$2"; printf '%s' "${!n:-}"; }            # service, key
upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }
envget() { sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -1; }   # file, key
skipped() { case " $RAMIFY_SKIP " in *" $1 "*) return 0 ;; esac; return 1; }
has_shared() { [ -n "$(sv "$1" shared_port)" ]; }

# `need_config any` accepts a config with no services: a repo can use ramify for branching alone.
need_config() {
  [ -n "$CONFIG" ] || die "no .ramify.conf or .claude/ramify.conf in $PRIMARY$([ "$REPO_ROOT" = "$PRIMARY" ] || echo " or $REPO_ROOT") — run 'ramify setup'"
  [ "${1:-}" = any ] && return 0
  [ -n "$RAMIFY_SERVICES" ] || die "$CONFIG declares no RAMIFY_SERVICES — no QA stack to run here (new, prune and delete still work)"
  local s
  for s in $RAMIFY_SERVICES; do
    [[ "$s" =~ ^[a-z_][a-z0-9_]*$ ]] || die "service name '$s' must match [a-z_][a-z0-9_]*"
    [ -n "$(sv "$s" port)" ] && [ -n "$(sv "$s" cmd)" ] || die "service '$s' needs ${s}_port and ${s}_cmd"
  done
}

port_of() { echo $(( $(sv "$1" port) + $2 )); }                # service, slot
slot_ports() { local s; for s in $RAMIFY_SERVICES; do port_of "$s" "$1"; done; }
bound() { lsof -ti:"$1" >/dev/null 2>&1; }
# Without a commit, rev-parse prints "HEAD" and fails: one line either way.
branch_of() { local b; b="$(git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null)" && echo "$b" || echo '?'; }

# ── Slots ────────────────────────────────────────────────────────────────────
# A claim whose pid is gone and whose ports answer nobody is a crash, not a claim.
slot_is_stale() {
  local holder pid p
  holder="$(cat "$SLOTS/$1" 2>/dev/null)" || return 1
  pid="${holder##* }"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 1
  for p in $(slot_ports "$1"); do bound "$p" && return 1; done
  return 0
}

# `set -o noclobber` with `>` is the lock: create-or-fail in one kernel call. `[ -f ]` then write
# has a window, and two sessions starting together is exactly when it is open.
claim_slot() {
  local slot p busy
  for slot in $(seq 1 "$RAMIFY_MAX_SLOT"); do
    if [ -f "$SLOTS/$slot" ]; then
      slot_is_stale "$slot" || continue
      rm -f "$SLOTS/$slot"
    fi
    # A port held by something outside the registry (another project, macOS ControlCenter on
    # :5000) makes the slot unusable, whoever holds it.
    busy=0; for p in $(slot_ports "$slot"); do bound "$p" && busy=1; done
    [ "$busy" = 1 ] && continue
    if (set -o noclobber; echo "$WORKTREE $$" >"$SLOTS/$slot") 2>/dev/null; then
      echo "$slot"; return 0
    fi
  done
  return 1
}

# Releases only a claim still in our name: a stale one someone else reclaimed is theirs now.
release_slot() { # slot, worktree
  [ -n "${1:-}" ] || return 0
  [ "$(cut -d' ' -f1 "$SLOTS/$1" 2>/dev/null)" = "$2" ] || return 0
  rm -f "$SLOTS/$1"
  echo "  slot $1 released"
}

holds_a_slot() {
  local s
  for s in $(seq 1 "$RAMIFY_MAX_SLOT"); do
    [ "$(cut -d' ' -f1 "$SLOTS/$s" 2>/dev/null)" = "$1" ] && return 0
  done
  return 1
}

# ── Starting things ──────────────────────────────────────────────────────────
wait_for() { # url, seconds
  local deadline=$(( $(date +%s) + ${2:-90} ))
  until curl -sf -o /dev/null "$1" 2>/dev/null; do
    [ "$(date +%s)" -ge "$deadline" ] && return 1
    sleep 2
  done
}

health_url() { echo "http://localhost:$2$(sv "$1" health)"; } # service, port

note_error() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$ERRORS"; } # service or step, log, message
fail() { note_error "$1" "$2" "$3"; die "$3"; }                        # same, then stop

ensure_containers() {
  [ -n "$RAMIFY_CONTAINERS$RAMIFY_COMPOSE_FILE" ] || return 0
  # Fail here rather than three steps later on a service that cannot reach its database.
  docker info >/dev/null 2>&1 || fail containers '' "Docker is not running. Start it, then run this again."
  local c missing=0
  for c in $RAMIFY_CONTAINERS; do
    docker ps --filter "name=^${c}\$" --filter status=running -q | grep -q . || missing=1
  done
  # Without named containers, ask compose whether every service of the fixed project runs.
  if [ -z "$RAMIFY_CONTAINERS" ]; then
    [ "$(docker compose -p "$RAMIFY_COMPOSE_PROJECT" -f "$PRIMARY/$RAMIFY_COMPOSE_FILE" ps --services --status running 2>/dev/null | sort)" \
      = "$(docker compose -f "$PRIMARY/$RAMIFY_COMPOSE_FILE" config --services 2>/dev/null | sort)" ] || missing=1
  fi
  if [ "$missing" = 0 ]; then
    echo "  containers      already up (shared)"; return
  fi
  [ -n "$RAMIFY_COMPOSE_FILE" ] || fail containers '' "containers down and no RAMIFY_COMPOSE_FILE to start them"
  # Never `down`: another session is likely mid-QA against these. The fixed -p is what stops a
  # worktree from creating a second, conflicting set named after its own directory.
  echo "  containers      starting under project '$RAMIFY_COMPOSE_PROJECT'…"
  docker compose -p "$RAMIFY_COMPOSE_PROJECT" -f "$PRIMARY/$RAMIFY_COMPOSE_FILE" up -d >"$STATE_DIR/$WORKTREE.compose.log" 2>&1 \
    || fail containers "$STATE_DIR/$WORKTREE.compose.log" "docker compose up failed"
}

# What this branch changed, committed or not — the point is what runs, not what is pushed.
changed_paths() {
  local base
  base="$(git -C "$REPO_ROOT" merge-base HEAD "$RAMIFY_REMOTE/$RAMIFY_MAIN" 2>/dev/null \
       || git -C "$REPO_ROOT" merge-base HEAD "$RAMIFY_MAIN" 2>/dev/null)"
  { [ -n "$base" ] && git -C "$REPO_ROOT" diff --name-only "$base"...HEAD
    git -C "$REPO_ROOT" status --porcelain | cut -c4- | sed 's/.* -> //'
  } 2>/dev/null
}

# A shared service stays shared while every changed path matches `<svc>_shared_when`: a branch
# that does not touch it compiles to the same thing as main, and that build is the slow part.
is_shared() {
  has_shared "$1" || return 1
  local re; re="$(sv "$1" shared_when)"
  [ -z "$re" ] && return 0
  ! changed_paths | grep -vE "$re" | grep -q .
}

# A service with `<svc>_when` runs only once some changed path matches it: a Storybook for a
# branch that touches no component costs RAM and shows nothing new.
unneeded() {
  local re; re="$(sv "$1" when)"
  [ -n "$re" ] && ! changed_paths | grep -qE "$re"
}

# The redirect wraps the whole subshell: redirecting only `nohup` leaves the forked shell holding
# the caller's stdout, and anything reading `ramify up` through a pipe then waits forever.
# Each service leads its own process group (perl setpgrp keeps the pid), so a stop reaches the
# grandchildren too: `npm run dev` and `dotnet watch` run the real server two levels down.
start_service() { # service, port, root, pidfile, logfile, cmd
  local dir="$3/$(sv "$1" dir)"
  (cd "$dir" && PORT="$2" exec nohup perl -e 'setpgrp(0, 0); exec @ARGV' bash -c "$6") >"$5" 2>&1 </dev/null &
  echo $! >"$4"
}

# The whole group; `pkill -P` covers a stack started before services had their own group.
stop_pidfile() { # pidfile
  local pid; pid="$(cat "$1" 2>/dev/null)"
  [ -n "$pid" ] && { kill -- "-$pid" 2>/dev/null || { pkill -P "$pid"; kill "$pid"; } 2>/dev/null; }
  rm -f "$1"
}

ensure_shared() { # service
  local s="$1" port; port="$(sv "$1" shared_port)"
  if curl -sf -o /dev/null --max-time 2 "$(health_url "$s" "$port")"; then
    printf '  %-15s http://localhost:%s  (shared, already up)\n' "$s" "$port"; return 0
  fi
  printf '  %-15s starting shared instance from %s…\n' "$s" "$(basename "$PRIMARY")"
  start_service "$s" "$port" "$PRIMARY" "$STATE_DIR/shared/$s.pid" "$STATE_DIR/shared/$s.log" \
    "$(sv "$s" shared_cmd)"
  if wait_for "$(health_url "$s" "$port")" "$(sv "$s" timeout || true)"; then
    printf '  %-15s http://localhost:%s  (shared, ready)\n' "$s" "$port"
  else
    printf '  %-15s shared instance NOT READY — see %s\n' "$s" "$STATE_DIR/shared/$s.log"
    note_error "$s" "$STATE_DIR/shared/$s.log" "shared instance did not answer $(health_url "$s" "$port")"; return 1
  fi
}

smoke() { # service, port — prints the http code when it is not one the config accepts
  local spec path codes got
  spec="$(sv "$1" smoke)"; [ -n "$spec" ] || return 0
  path="${spec%% *}"; codes="${spec#* }"
  got="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://localhost:$2$path" 2>/dev/null)"
  [[ "$got" =~ ^($codes)$ ]] || { echo "$path returned $got"; return 1; }
}

up() {
  need_config
  rm -f "$ERRORS"
  # Idempotent: a live stack is reported, not doubled. A second claim would orphan the first slot.
  if [ -f "$STATE" ]; then
    if ping; then tile "$WORKTREE" smoke; return 0; fi
    kill_worktree "$WORKTREE" >/dev/null
  fi
  echo "Stack for $WORKTREE ($(branch_of "$REPO_ROOT"))"
  ensure_containers

  local slot s U port cmd rc late=""
  slot="$(claim_slot)" || fail slots '' "all $RAMIFY_MAX_SLOT slots taken — 'ramify status' shows who holds them"
  echo "  slot            $slot"
  printf 'SLOT=%s\n' "$slot" >"$STATE"

  for s in $RAMIFY_SERVICES; do
    skipped "$s" && continue
    unneeded "$s" && { printf '  %-15s not needed — nothing changed matches %s_when\n' "$s" "$s"; continue; }
    U="$(upper "$s")"
    if is_shared "$s"; then
      port="$(sv "$s" shared_port)"
      ensure_shared "$s" || { kill_worktree "$WORKTREE" >/dev/null; exit 1; }
      printf '%s_PORT=%s\n%s_SHARED=1\n' "$U" "$port" "$U" >>"$STATE"
    else
      port="$(port_of "$s" "$slot")"
      cmd="$(sv "$s" prepare)"
      if [ -n "$cmd" ]; then
        printf '  %-15s preparing\n' "$s"
        (cd "$REPO_ROOT/$(sv "$s" dir)" && bash -c "$cmd") >"$STATE_DIR/$WORKTREE.$s.prepare.log" 2>&1 \
          || { rc=$?; printf '  %-15s prepare FAILED — see %s\n' "$s" "$STATE_DIR/$WORKTREE.$s.prepare.log"
               note_error "$s" "$STATE_DIR/$WORKTREE.$s.prepare.log" "prepare failed (exit $rc)"
               kill_worktree "$WORKTREE" >/dev/null; exit 1; }
      fi
      start_service "$s" "$port" "$REPO_ROOT" "$STATE_DIR/$WORKTREE.$s.pid" "$STATE_DIR/$WORKTREE.$s.log" \
        "$(sv "$s" cmd)"
      printf '%s_PORT=%s\n%s_SHARED=0\n' "$U" "$port" "$U" >>"$STATE"
      # Readiness is an answered request, not a started process. Optional services boot last and
      # nothing waits on them.
      if [ -n "$(sv "$s" optional)" ]; then
        late="$late $s"
      elif wait_for "$(health_url "$s" "$port")" "$(sv "$s" timeout || true)"; then
        printf '  %-15s http://localhost:%s  (ready)\n' "$s" "$port"
      else
        printf '  %-15s http://localhost:%s  NOT READY — see %s\n' "$s" "$port" "$STATE_DIR/$WORKTREE.$s.log"
        note_error "$s" "$STATE_DIR/$WORKTREE.$s.log" "did not answer $(health_url "$s" "$port") in time"
      fi
    fi
    # Later services read earlier ports: `VITE_API_TARGET=http://localhost:$API_PORT`.
    export "${U}_PORT=$port"
  done

  for s in $RAMIFY_SERVICES; do
    port="$(envget "$STATE" "$(upper "$s")_PORT")"; [ -n "$port" ] || continue
    smoke "$s" "$port" >/dev/null || printf '  %-15s smoke %s  <-- check the wiring\n' "$s" "$(smoke "$s" "$port")"
  done
  for s in $late; do
    port="$(envget "$STATE" "$(upper "$s")_PORT")"
    if wait_for "$(health_url "$s" "$port")" "$(sv "$s" timeout || true)"; then
      printf '  %-15s http://localhost:%s  (ready)\n' "$s" "$port"
    else
      printf '  %-15s http://localhost:%s  still starting — see %s\n' "$s" "$port" "$STATE_DIR/$WORKTREE.$s.log"
    fi
  done
  echo
  tile "$WORKTREE"
}

# ── Stopping things ──────────────────────────────────────────────────────────
# Stops one worktree's own processes. Shared instances and containers are never touched here:
# killing by port where a service was shared would tear down what every other worktree uses.
kill_worktree() { # worktree
  local wt="$1" env="$STATE_DIR/$1.env" pidfile s U port
  for pidfile in "$STATE_DIR/$wt".*.pid; do
    [ -f "$pidfile" ] && stop_pidfile "$pidfile"
  done
  for s in $RAMIFY_SERVICES; do
    U="$(upper "$s")"
    [ "$(envget "$env" "${U}_SHARED")" = 1 ] && continue
    port="$(envget "$env" "${U}_PORT")"
    [ -n "$port" ] && lsof -ti:"$port" 2>/dev/null | xargs kill 2>/dev/null
  done
  release_slot "$(envget "$env" SLOT)" "$wt"
  rm -f "$env"
}

down() {
  need_config
  kill_worktree "$WORKTREE"
  rm -f "$ERRORS"
  echo "$WORKTREE stopped. Shared containers and instances left running on purpose."
}

shared_down() {
  need_config
  local s pidfile port
  for s in $RAMIFY_SERVICES; do
    has_shared "$s" || continue
    pidfile="$STATE_DIR/shared/$s.pid"
    [ -f "$pidfile" ] && stop_pidfile "$pidfile"
    port="$(sv "$s" shared_port)"
    lsof -ti:"$port" 2>/dev/null | xargs kill 2>/dev/null
    echo "shared $s :$port stopped — every worktree pointed at it now reaches nothing"
  done
}

worktree_root() {
  git -C "$PRIMARY" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}' \
    | while read -r p; do [ "$(basename "$p")" = "$1" ] && { echo "$p"; break; }; done
}

stack_is_down() { # worktree
  local env="$STATE_DIR/$1.env" s U port
  [ -f "$env" ] || return 0
  for s in $RAMIFY_SERVICES; do
    U="$(upper "$s")"
    [ "$(envget "$env" "${U}_SHARED")" = 1 ] && continue
    port="$(envget "$env" "${U}_PORT")"
    [ -n "$port" ] && bound "$port" && return 1
  done
  return 0
}

# Takes back what a week of sessions leaks: crashed claims, orphans (a stack on a slot its own
# state no longer points at), and state of worktrees deleted under a running stack. Anything
# alive, the containers and the shared instances stay where they are.
cleanup() {
  need_config
  local slot holder held found=0 wt port pidfile removed
  # Without a worktree list every holder looks deleted. Refuse rather than kill the machine's QA.
  [ "$(git -C "$PRIMARY" worktree list --porcelain 2>/dev/null | grep -c '^worktree ')" -gt 0 ] \
    || { echo "cannot read the worktree list from $PRIMARY — refusing to clean" >&2; return 1; }

  for slot in $(seq 1 "$RAMIFY_MAX_SLOT"); do
    [ -f "$SLOTS/$slot" ] || continue
    holder="$(cut -d' ' -f1 "$SLOTS/$slot")"
    held="$(envget "$STATE_DIR/$holder.env" SLOT)"
    if slot_is_stale "$slot"; then
      rm -f "$SLOTS/$slot"; found=1
      echo "  slot $slot        released — $holder left it claimed with nothing running"
    elif [ -n "$held" ] && [ "$held" != "$slot" ]; then
      # No pid file points at an orphan any more; the port is the only way in.
      for port in $(slot_ports "$slot"); do lsof -ti:"$port" 2>/dev/null | xargs kill 2>/dev/null; done
      rm -f "$SLOTS/$slot"; found=1
      echo "  slot $slot        orphan of $holder killed — its state had moved to slot $held"
    elif [ -z "$(worktree_root "$holder")" ]; then
      echo "  slot $slot        $holder stopped — its worktree no longer exists"
      kill_worktree "$holder"; found=1
    fi
  done

  while read -r wt; do
    [ -n "$wt" ] || continue
    if [ -z "$(worktree_root "$wt")" ]; then
      kill_worktree "$wt" >/dev/null
      rm -f "$STATE_DIR/$wt".*.log "$STATE_DIR/$wt".*.pid "$STATE_DIR/$wt.env" "$STATE_DIR/$wt.errors"
      echo "  state          $wt removed — its worktree no longer exists"; found=1
    elif ! holds_a_slot "$wt" && stack_is_down "$wt"; then
      # Logs stay as the post-mortem; only state that lies about what runs goes.
      removed=0
      for pidfile in "$STATE_DIR/$wt".*.pid; do
        [ -f "$pidfile" ] || continue
        kill -0 "$(cat "$pidfile")" 2>/dev/null && continue
        rm -f "$pidfile"; removed=1
      done
      [ -f "$STATE_DIR/$wt.env" ] && { rm -f "$STATE_DIR/$wt.env"; removed=1; }
      [ "$removed" = 1 ] && { echo "  state          $wt cleared — its stack is not running any more"; found=1; }
    fi
  done < <(ls "$STATE_DIR" 2>/dev/null | sed -n -E 's/\.(env|[a-z0-9_]+(\.prepare)?\.(log|pid))$//p' | sort -u)

  close_merged_tickets && found=1
  [ "$found" = 0 ] && echo "nothing to clean — every claimed slot has a live stack behind it"
  return 0
}

# ── Branches ─────────────────────────────────────────────────────────────────
# Why a branch is safe to delete, or nothing. Hosts that rewrite main around a merge make "is an
# ancestor" miss most merged branches, so three tests:
#  - ancestor of main with its remote gone (a bare ancestor may be a fresh branch, not a merged one);
#  - its content already in main, and it has commits of its own;
#  - main carries its merge commit (Bitbucket « Merged in <b> (pull request », GitHub
#    « Merge pull request #N from <owner>/<b> ») and nothing on it is newer.
merged_reason() { # branch
  local b="$1" main="$RAMIFY_REMOTE/$RAMIFY_MAIN" track merge re
  track="$(git -C "$PRIMARY" for-each-ref --format='%(upstream:track)' "refs/heads/$b")"
  if git -C "$PRIMARY" merge-base --is-ancestor "$b" "$main"; then
    [ "$track" = '[gone]' ] && { echo 'ancestor of main, remote gone'; return; }
  elif [ "$(git -C "$PRIMARY" merge-tree --write-tree "$main" "$b" 2>/dev/null | head -1)" \
       = "$(git -C "$PRIMARY" rev-parse "$main^{tree}")" ]; then
    echo 'content already in main'; return
  fi
  re="$(printf '%s' "$b" | sed 's/[.[\*^$()+?{}|]/\\&/g')"
  merge="$(git -C "$PRIMARY" log "$main" -1 --format=%ct -E \
    --grep="^Merged in $re \\(pull request" --grep="^Merge pull request #[0-9]+ from [^ ]+/$re\$")"
  [ -n "$merge" ] && [ "$(git -C "$PRIMARY" log -1 --format=%ct "$b")" -le "$merge" ] \
    && echo 'PR merged, nothing newer on it'
}

# Merged local branches and their worktrees. Dry run unless --apply. Dirty trees, the primary
# checkout and the one this runs from are kept; remote branches are never touched.
prune() { # [--apply]
  local apply="${1:-}" b reason path here key kept=0 n=0
  here="$(git rev-parse --show-toplevel 2>/dev/null)"
  git -C "$PRIMARY" fetch -p -q "$RAMIFY_REMOTE" 2>/dev/null || echo "  (fetch failed — judging on the last known $RAMIFY_REMOTE/$RAMIFY_MAIN)"
  [ "$apply" = --apply ] && git -C "$PRIMARY" worktree prune
  while read -r b; do
    [ "$b" = "$RAMIFY_MAIN" ] && continue
    reason="$(merged_reason "$b")"
    [ -n "$reason" ] || continue
    path="$(git -C "$PRIMARY" worktree list --porcelain \
      | awk -v r="refs/heads/$b" '/^worktree /{p=$2} $0=="branch "r{print p}')"
    if [ -n "$path" ] && [ -d "$path" ]; then
      if [ "$path" = "$PRIMARY" ] || [ "$path" = "$here" ]; then
        printf '  keep   %-45s checked out here\n' "$b"; kept=$((kept + 1)); continue
      fi
      if [ -n "$(git -C "$path" status --porcelain)" ]; then
        printf '  keep   %-45s %s has uncommitted changes\n' "$b" "$(basename "$path")"; kept=$((kept + 1)); continue
      fi
    fi
    printf '  prune  %-45s %s%s\n' "$b" "$reason" "${path:+ + worktree $(basename "$path")}"
    n=$((n + 1))
    key="$(ticket_of "$b")"
    [ "$apply" = --apply ] || { [ -n "$key" ] && printf '         %s\n' "$(ticket_note "$key")"; continue; }
    # Remove first: a failed remove must leave the tree's stack and state as they were.
    if [ -n "$path" ] && [ -d "$path" ]; then
      git -C "$PRIMARY" worktree remove "$path" || { echo "    worktree remove failed — branch and stack kept"; continue; }
      forget_worktree "$(basename "$path")"
    fi
    git -C "$PRIMARY" branch -D -q "$b"
    # After the removal: a kept branch keeps its ticket open. A failed close costs nothing, the
    # work is merged; it is said, and the ticket stays for a human.
    [ -n "$key" ] && { jira close "$key" 2>&1 | sed 's/^jira: //; s/^/         /'; }
  done < <(git -C "$PRIMARY" for-each-ref --format='%(refname:short)' refs/heads)
  if [ "$n" = 0 ]; then echo "nothing merged to prune"
  elif [ "$apply" = --apply ]; then echo "$n pruned, $kept kept"
  else echo "$n to prune, $kept kept — 'ramify prune --apply' does it"; fi
}

forget_worktree() { # worktree — stop its stack, drop its state and logs
  [ -n "$CONFIG" ] && kill_worktree "$1" >/dev/null
  rm -f "$STATE_DIR/$1".*.log "$STATE_DIR/$1".*.pid "$STATE_DIR/$1.env" "$STATE_DIR/$1.errors"
}

# One worktree and its branch, merged or not. Says what is lost, then wants --yes or a yes.
force_delete() { # worktree name or path, [--yes]
  local path b dirty unpushed here
  path="$(worktree_root "$(basename "${1:-}")")"
  [ -n "$path" ] || { echo "no worktree named '${1:-}'" >&2; return 1; }
  here="$(git rev-parse --show-toplevel 2>/dev/null)"
  [ "$path" = "$PRIMARY" ] && { echo "refusing: $path is the primary checkout" >&2; return 1; }
  [ "$path" = "$here" ] && { echo "refusing: this shell is inside $path" >&2; return 1; }
  b="$(git -C "$path" symbolic-ref --short -q HEAD)"
  dirty="$(git -C "$path" status --porcelain | wc -l | tr -d ' ')"
  unpushed="$([ -n "$b" ] && git -C "$PRIMARY" rev-list --count "$b" --not --remotes 2>/dev/null || echo 0)"
  echo "force delete $(basename "$path") (${b:-detached}): $dirty uncommitted file(s), $unpushed commit(s) on no remote"
  if [ "${2:-}" != --yes ]; then
    [ -t 0 ] || { echo "add --yes to confirm" >&2; return 1; }
    choose "Delete it? This cannot be undone." "Delete" "Back"
    [ "$CHOICE" = 0 ] || return 0
  fi
  git -C "$PRIMARY" worktree remove --force --force "$path" || return 1
  forget_worktree "$(basename "$path")"
  [ -n "$b" ] && git -C "$PRIMARY" branch -D -q "$b"
  echo "deleted $(basename "$path")${b:+ and $b}"
}

# ── Tickets ──────────────────────────────────────────────────────────────────
# The Jira key in a branch name, upper-cased: story/tm-127-pagination → TM-127. Whole words only,
# so story/backend-under-3min carries none. Nothing without RAMIFY_JIRA_URL.
ticket_of() { # branch
  [ -n "$RAMIFY_JIRA_URL" ] || return 0
  local s="-${1//\//-}-"
  [[ "$s" =~ -($RAMIFY_TICKET_PATTERN)- ]] && upper "${BASH_REMATCH[1]}"
  return 0
}

jira() { RAMIFY_JIRA_DONE="$RAMIFY_JIRA_DONE" python3 "$RAMIFY_HOME/libexec/jira.py" "$1" "$RAMIFY_JIRA_URL" "${@:2}"; }

ticket_note() { # key → what closing it would do
  local out cat name
  out="$(jira status "$1" 2>&1)" || { echo "${out#jira: }"; return; }
  IFS=$'\t' read -r _ cat name <<<"$out"
  case "$cat" in
    done) echo "$1 already $name" ;;
    missing) echo "$1 not found in Jira, nothing to close" ;;
    *) echo "closes $1 ($name)" ;;
  esac
}

# The open tickets of merged branches still here, closed. Nothing is removed: that is `prune`.
# Judged on the last fetched main, like the rest of `cleanup`. True when it closed one.
close_merged_tickets() {
  [ -n "$RAMIFY_JIRA_URL" ] || return 1
  local b key note closed=1
  while read -r b; do
    [ "$b" = "$RAMIFY_MAIN" ] && continue
    key="$(ticket_of "$b")"; [ -n "$key" ] || continue
    [ -n "$(merged_reason "$b")" ] || continue
    note="$(ticket_note "$key")"
    case "$note" in
      closes*) printf '  ticket         %s\n' "$(jira close "$key" 2>&1 | sed 's/^jira: //')"; closed=0 ;;
      *already*|*"not found"*) ;;
      *) printf '  ticket         %s: %s\n' "$key" "$note"; closed=0 ;;
    esac
  done < <(git -C "$PRIMARY" for-each-ref --format='%(refname:short)' refs/heads)
  return "$closed"
}

# The token goes to the Keychain, never to the repo config: that file is committed.
jira_login() {
  [ -n "$RAMIFY_JIRA_URL" ] || die "set RAMIFY_JIRA_URL=https://<site>.atlassian.net in ${CONFIG:-.ramify.conf} first"
  [ -t 0 ] || die "'ramify jira login' asks for a token: run it in a terminal"
  command -v security >/dev/null || die "no macOS Keychain here: export RAMIFY_JIRA_EMAIL and RAMIFY_JIRA_TOKEN instead"
  local host email
  host="$(printf '%s' "$RAMIFY_JIRA_URL" | sed -E 's#^[a-z]+://##; s#[/:].*##')"
  read -rp "Atlassian email for $host: " email
  [ -n "$email" ] || die "no email given"
  echo "API token, from https://id.atlassian.com/manage-profile/security/api-tokens"
  while security delete-generic-password -s "ramify-jira:$host" >/dev/null 2>&1; do :; done
  # -w last: security prompts for the token itself, so it never sits in argv or in shell history.
  security add-generic-password -s "ramify-jira:$host" -a "$email" -l "ramify Jira token ($host)" -w || die "the Keychain refused the token"
  jira check
}

# Done with a branch: close its ticket, stop its stack, remove the worktree and the local branch.
# Nothing uncommitted or unpushed may go with it; that is `delete`, which says what it loses.
complete_tree() { # worktree name or path, [--yes]
  local path b dirty unpushed here key
  path="$(worktree_root "$(basename "${1:-}")")"
  [ -n "$path" ] || { echo "no worktree named '${1:-}'" >&2; return 1; }
  here="$(git rev-parse --show-toplevel 2>/dev/null)"
  [ "$path" = "$PRIMARY" ] && { echo "refusing: $path is the primary checkout" >&2; return 1; }
  [ "$path" = "$here" ] && { echo "refusing: this shell is inside $path" >&2; return 1; }
  b="$(git -C "$path" symbolic-ref --short -q HEAD)"
  dirty="$(git -C "$path" status --porcelain | wc -l | tr -d ' ')"
  unpushed="$([ -n "$b" ] && git -C "$PRIMARY" rev-list --count "$b" --not --remotes 2>/dev/null || echo 0)"
  [ "$dirty" = 0 ] || { echo "refusing: $(basename "$path") has $dirty uncommitted file(s) — commit and push them, or 'ramify delete'" >&2; return 1; }
  [ "$unpushed" = 0 ] || { echo "refusing: $unpushed commit(s) of $b are on no remote — push them, or 'ramify delete'" >&2; return 1; }
  key="$(ticket_of "$b")"
  echo "complete $(basename "$path") (${b:-detached})${key:+ — $(ticket_note "$key")}"
  if [ "${2:-}" != --yes ]; then
    [ -t 0 ] || { echo "add --yes to confirm" >&2; return 1; }
    choose "Complete it?" "Complete" "Back"
    [ "$CHOICE" = 0 ] || return 0
  fi
  # The ticket first: when Jira says no, the tree is still there to try again.
  if [ -n "$key" ]; then
    jira close "$key" || { echo "ticket not closed, $(basename "$path") kept — run it again once Jira answers" >&2; return 1; }
  fi
  git -C "$PRIMARY" worktree remove "$path" || return 1
  forget_worktree "$(basename "$path")"
  [ -n "$b" ] && git -C "$PRIMARY" branch -D -q "$b"
  echo "completed $(basename "$path")${b:+, $b removed here (its remote branch is kept)}"
}

# `/color` takes one of eight names; hashing the slug keeps a tree's colour across sessions.
label() { # [slug]
  local slug="${1:-$WORKTREE}" c=(red blue green yellow purple orange pink cyan) h
  h="$(printf %s "$slug" | { md5 -q 2>/dev/null || md5sum; } | cut -c1-8)"
  echo "/rename $slug"
  echo "/color ${c[$(( 0x$h % 8 ))]}"
}

# Base on the remote main, never on this checkout's HEAD: it may sit on someone else's branch.
new() { # slug
  local slug="${1:-}" parent dest branch p wt autostart=0
  [ -n "$slug" ] || die "usage: ramify new <slug>"
  case "$RAMIFY_WORKTREES" in /*) parent="$RAMIFY_WORKTREES" ;; *) parent="$PRIMARY/$RAMIFY_WORKTREES" ;; esac
  mkdir -p "$parent" && parent="$(cd "$parent" && pwd)"
  dest="$parent/$slug"; branch="$RAMIFY_BRANCH_PREFIX$slug"; wt="$slug"
  git -C "$PRIMARY" fetch -q "$RAMIFY_REMOTE" "$RAMIFY_MAIN" || echo "  (fetch failed — cutting from the last known $RAMIFY_REMOTE/$RAMIFY_MAIN)"
  # --no-track: a branch tracking main would pull main and never show its own remote as gone.
  git -C "$PRIMARY" worktree add -q --no-track -b "$branch" "$dest" "$RAMIFY_REMOTE/$RAMIFY_MAIN" || exit 1

  # A worktree carries tracked files only. --ignore-existing keeps tracked copies the checkout
  # just wrote; the exclude keeps an agent harness's nested worktrees from being duplicated.
  for p in $RAMIFY_COPY; do
    if [ -d "$PRIMARY/$p" ]; then
      mkdir -p "$dest/$p"
      rsync -a --ignore-existing ${RAMIFY_COPY_EXCLUDE:+--exclude "$RAMIFY_COPY_EXCLUDE"} "$PRIMARY/$p/" "$dest/$p/"
    elif [ -e "$PRIMARY/$p" ] && [ ! -e "$dest/$p" ]; then
      mkdir -p "$(dirname "$dest/$p")" && cp -p "$PRIMARY/$p" "$dest/$p"
    fi
  done

  [ -n "$CONFIG" ] && [ -n "$RAMIFY_SERVICES" ] && [ "${RAMIFY_AUTOSTART:-1}" = 1 ] && autostart=1
  if [ -n "$RAMIFY_BOOTSTRAP" ] || [ "$autostart" = 1 ]; then
    mkdir -p "$STATE_DIR"; rm -f "$STATE_DIR/$wt.errors"
    # A failed bootstrap is recorded like a failed `up`: nobody reads the log of a background job.
    (cd "$dest" && exec nohup bash -c 'eval "${1:-true}" || { printf "bootstrap\t%s\tbootstrap failed (exit %s)\n" "$6" "$?" >>"$5"; exit 1; }
       [ "$3" = 1 ] && RAMIFY_ROOT="$2" "$4" up' \
       _ "$RAMIFY_BOOTSTRAP" "$dest" "$autostart" "$SELF" "$STATE_DIR/$wt.errors" "$STATE_DIR/$wt.bootstrap.log") \
       >"$STATE_DIR/$wt.bootstrap.log" 2>&1 </dev/null &
    echo "  bootstrap       running in the background — $STATE_DIR/$wt.bootstrap.log"
  fi
  echo "  branch          $branch (from $RAMIFY_REMOTE/$RAMIFY_MAIN)"
  # The PostToolUse hook reads this exact line to follow the session into the new tree.
  echo "ramify: worktree $dest"
  label "$slug"
}

# ── Reporting ────────────────────────────────────────────────────────────────
status() {
  need_config
  local c s slot holder live
  [ -n "$RAMIFY_CONTAINERS" ] && { echo "containers (shared):"
    for c in $RAMIFY_CONTAINERS; do docker ps --filter "name=^${c}\$" --format '  {{.Names}}  {{.Status}}'; done; }
  for s in $RAMIFY_SERVICES; do
    has_shared "$s" || continue
    printf 'shared %s :%s  %s\n' "$s" "$(sv "$s" shared_port)" \
      "$(curl -sf -o /dev/null --max-time 2 "$(health_url "$s" "$(sv "$s" shared_port)")" && echo up || echo 'not running')"
  done
  echo "port slots ($SLOTS):"
  for slot in $(seq 1 "$RAMIFY_MAX_SLOT"); do
    if [ -f "$SLOTS/$slot" ]; then
      holder="$(cut -d' ' -f1 "$SLOTS/$slot")"
      stack_is_down "$holder" && live="STALE (nothing on its ports)" || live="up"
      printf '  %-3s %-30s %s\n' "$slot" "$holder" "$live"
    else
      printf '  %-3s %-30s %s\n' "$slot" "" "free ($(slot_ports "$slot" | sed 's/^/:/' | tr '\n' ' '))"
    fi
  done
}

# Exit 0 when every started, non-optional service of this worktree answers. The Stop hook's fast path.
ping() {
  need_config
  [ -f "$STATE" ] || return 1
  local s port
  for s in $RAMIFY_SERVICES; do
    [ -n "$(sv "$s" optional)" ] && continue
    port="$(envget "$STATE" "$(upper "$s")_PORT")"; [ -n "$port" ] || continue
    curl -sf -o /dev/null --max-time 2 "$(health_url "$s" "$port")" || return 1
  done
}

BOX_W=64
BOX_LINE="$(printf '─%.0s' $(seq 1 $((BOX_W + 2))))"
row() { printf '│ %s%*s │\n' "$1" $((BOX_W - ${#1})) ''; }
row2() { printf '│ %s%*s %s │\n' "$1" $((BOX_W - ${#1} - ${#2} - 1)) '' "$2"; }

# Bound but not answering is "starting": a build holds its port a while before it serves.
probe() { # service, port
  [ -n "${2:-}" ] || { echo '—'; return; }
  bound "$2" || { echo 'down'; return; }
  [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "$(health_url "$1" "$2")" 2>/dev/null)" = 200 ] \
    && echo 'ready' || echo 'starting'
}

uptime_of() { # file
  [ -f "$1" ] || { echo '—'; return; }
  local s=$(( $(date +%s) - $(stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || date +%s) ))
  if [ "$s" -lt 3600 ]; then printf '%dm' $((s / 60)); else printf '%dh%02dm' $((s / 3600)) $(((s % 3600) / 60)); fi
}

tile() { # worktree, [smoke]
  local wt="$1" env="$STATE_DIR/$1.env" root branch s U port kind out
  [ -f "$env" ] || { echo "no stack for $wt — run 'ramify up'"; return 1; }
  root="$(worktree_root "$wt")"
  branch="$(branch_of "${root:-$REPO_ROOT}")"
  [ -n "$(git -C "${root:-$REPO_ROOT}" status --porcelain 2>/dev/null)" ] && branch="$branch *"
  printf '┌%s┐\n' "$BOX_LINE"
  row2 "$wt" "slot $(envget "$env" SLOT)"
  row2 "$branch" "up $(uptime_of "$env")"
  printf '├%s┤\n' "$BOX_LINE"
  for s in $RAMIFY_SERVICES; do
    U="$(upper "$s")"; port="$(envget "$env" "${U}_PORT")"; [ -n "$port" ] || continue
    kind="$s"; has_shared "$s" && { [ "$(envget "$env" "${U}_SHARED")" = 1 ] && kind="$s shared" || kind="$s private"; }
    row2 "$(printf '%-12s %s' "$kind" "http://localhost:$port")" "$(probe "$s" "$port")"
    if [ "${2:-}" = smoke ] && ! out="$(smoke "$s" "$port")"; then
      row "$(printf '%-12s %s' '  smoke' "$out")"
    fi
  done
  printf '└%s┘\n' "$BOX_LINE"
}

# Primary checkouts of every configured project, one per line: the ones that run QA stacks, or
# with `all` the branching-only ones too. The /tmp records still count for projects not seen
# since the registry existed. A repo that was moved or lost its config drops out.
projects() { # [all]
  local p
  cat "$REGISTRY" "$STATE_ROOT"/*/primary 2>/dev/null | sort -u | while read -r p; do
    [ -n "$p" ] && [ -d "$p" ] || continue
    if [ "${1:-}" = all ]; then RAMIFY_ROOT="$p" "$SELF" config -q >/dev/null 2>&1 && echo "$p"
    else [ -n "$(RAMIFY_ROOT="$p" "$SELF" config get RAMIFY_SERVICES 2>/dev/null)" ] && echo "$p"; fi
  done
}

dash() {
  local list n p
  list="$(projects)"; n="$(printf '%s' "$list" | grep -c .)"
  [ "$n" = 0 ] && { echo "no ramify project on this machine yet — 'ramify setup' in a repo, then 'ramify up'"; return 0; }
  while read -r p; do
    [ "$n" -gt 1 ] && printf '━━ %s ━━\n' "$(basename "$p")"
    RAMIFY_ROOT="$p" "$SELF" dash-project
    [ "$n" -gt 1 ] && echo
  done <<<"$list"
  return 0
}

dash_project() {
  need_config
  local c s claimed=0 slot holder held line=""
  for c in $RAMIFY_CONTAINERS; do
    line="$line$c $(docker ps --filter "name=^${c}\$" --filter status=running -q 2>/dev/null | grep -q . && echo up || echo DOWN)   "
  done
  for s in $RAMIFY_SERVICES; do
    has_shared "$s" || continue
    line="${line}shared $s :$(sv "$s" shared_port) $(curl -sf -o /dev/null --max-time 2 "$(health_url "$s" "$(sv "$s" shared_port)")" && echo up || echo 'not running')   "
  done
  [ -n "$line" ] && printf '%s\n\n' "$line"
  for slot in $(seq 1 "$RAMIFY_MAX_SLOT"); do
    [ -f "$SLOTS/$slot" ] || continue
    holder="$(cut -d' ' -f1 "$SLOTS/$slot")"
    # One env file per worktree: a second `up` without a `down` leaves the first stack on a slot
    # nothing points at any more. Say so instead of drawing the worktree twice.
    held="$(envget "$STATE_DIR/$holder.env" SLOT)"
    if [ -n "$held" ] && [ "$held" != "$slot" ]; then
      printf 'slot %-2s ORPHAN — %s still runs here but its state moved to slot %s (ramify cleanup)\n\n' "$slot" "$holder" "$held"
      continue
    fi
    tile "$holder" && claimed=$((claimed + 1))
  done
  [ "$claimed" = 0 ] && echo "no stack running — 'ramify up' in a worktree starts one"
  return 0
}

# ── JSON, for the desktop app ────────────────────────────────────────────────
js() { local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; printf '"%s"' "${s//$'\t'/\\t}"; }
jsep() { [ "$1" = 0 ] || printf ','; }

dash_json() { # every project, as one array
  local p i=0
  printf '['
  while read -r p; do
    [ -n "$p" ] || continue
    jsep "$i"; i=1
    RAMIFY_ROOT="$p" "$SELF" dash-project --json
  done < <(projects all)
  printf ']\n'
}

errors_json() { # errors file → [{"service","log","message"}]
  local i=0 svc log msg
  printf '['
  [ -f "$1" ] && while IFS=$'\t' read -r svc log msg; do
    jsep "$i"; i=1
    printf '{"service":%s,"log":%s,"message":%s}' "$(js "$svc")" "$([ -n "$log" ] && [ -f "$log" ] && js "$log" || echo null)" "$(js "$msg")"
  done <"$1"
  printf ']'
}

# Every worktree of the project, running or not: the app acts on stopped ones too. A
# branching-only project comes with `"stacks":false` and no services.
dash_project_json() {
  need_config any
  local c s i path wt env slot U port kind held first log b key
  printf '{"name":%s,"primary":%s,"stacks":%s,"jira":%s,"containers":[' "$(js "$RAMIFY_PROJECT")" "$(js "$PRIMARY")" \
    "$([ -n "$RAMIFY_SERVICES" ] && echo true || echo false)" "$([ -n "$RAMIFY_JIRA_URL" ] && js "${RAMIFY_JIRA_URL%/}" || echo null)"
  i=0; for c in $RAMIFY_CONTAINERS; do
    jsep "$i"; i=1
    printf '{"name":%s,"up":%s}' "$(js "$c")" \
      "$(docker ps --filter "name=^${c}\$" --filter status=running -q 2>/dev/null | grep -q . && echo true || echo false)"
  done
  printf '],"shared":['
  i=0; for s in $RAMIFY_SERVICES; do
    has_shared "$s" || continue
    jsep "$i"; i=1; port="$(sv "$s" shared_port)"
    printf '{"service":%s,"port":%s,"up":%s}' "$(js "$s")" "$port" \
      "$(curl -sf -o /dev/null --max-time 2 "$(health_url "$s" "$port")" && echo true || echo false)"
  done
  printf '],"orphans":['
  i=0; for slot in $(seq 1 "$RAMIFY_MAX_SLOT"); do
    [ -f "$SLOTS/$slot" ] || continue
    wt="$(cut -d' ' -f1 "$SLOTS/$slot")"; held="$(envget "$STATE_DIR/$wt.env" SLOT)"
    [ -n "$held" ] && [ "$held" != "$slot" ] || continue
    jsep "$i"; i=1; printf '{"slot":%s,"worktree":%s,"moved_to":%s}' "$slot" "$(js "$wt")" "$held"
  done
  printf '],"worktrees":['
  first=0
  while read -r path; do
    wt="$(basename "$path")"; env="$STATE_DIR/$wt.env"; slot="$(envget "$env" SLOT)"
    jsep "$first"; first=1
    b="$(branch_of "$path")"; key="$(ticket_of "$b")"
    printf '{"name":%s,"path":%s,"branch":%s,"ticket":%s,"primary":%s,"dirty":%s,"slot":%s,"uptime":%s,"errors":%s,"services":[' \
      "$(js "$wt")" "$(js "$path")" "$(js "$b")" "$([ -n "$key" ] && js "$key" || echo null)" \
      "$([ "$path" = "$PRIMARY" ] && echo true || echo false)" \
      "$([ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ] && echo true || echo false)" \
      "${slot:-null}" "$([ -f "$env" ] && js "$(uptime_of "$env")" || echo null)" "$(errors_json "$STATE_DIR/$wt.errors")"
    i=0; for s in $RAMIFY_SERVICES; do
      U="$(upper "$s")"; port="$(envget "$env" "${U}_PORT")"; [ -n "$port" ] || continue
      kind=own; has_shared "$s" && { [ "$(envget "$env" "${U}_SHARED")" = 1 ] && kind=shared || kind=private; }
      jsep "$i"; i=1
      log="$STATE_DIR/$wt.$s.log"; [ "$kind" = shared ] && log="$STATE_DIR/shared/$s.log"
      printf '{"name":%s,"port":%s,"kind":"%s","state":"%s","log":%s}' "$(js "$s")" "$port" "$kind" "$(probe "$s" "$port")" \
        "$([ -f "$log" ] && js "$log" || echo null)"
    done
    printf ']}'
  done < <(git -C "$PRIMARY" worktree list --porcelain | awk '/^worktree /{print $2}')
  printf ']}'
}

clear_screen() { [ -t 1 ] && printf '\033[H\033[2J\033[3J'; }

# Arrow-key picker: ↑/↓ or j/k, enter picks, esc/q cancels. Sets CHOICE to the index, or -1.
# ponytail: no scrolling — a list taller than the terminal breaks the redraw; add a window if it grows.
choose() { # title, options…
  local title="$1" sel=0 n i k rest; shift; n=$#
  printf '\033[?25l%s\n' "$title"
  while :; do
    for ((i = 0; i < n; i++)); do
      local opt="${@:$((i + 1)):1}"
      if [ "$i" = "$sel" ]; then printf '\033[2K\033[36m❯ %s\033[0m\n' "$opt"
      else printf '\033[2K  %s\n' "$opt"; fi
    done
    printf '\033[2K\033[2m↑/↓ move · enter select · esc back\033[0m\n'
    IFS= read -rsn1 k
    if [ "$k" = $'\e' ]; then
      rest=''; IFS= read -rsn2 -t 1 rest
      case "$rest" in '[A') k=k ;; '[B') k=j ;; '') k=q ;; esac
    fi
    case "$k" in
      k) sel=$(( (sel - 1 + n) % n )) ;;
      j) sel=$(( (sel + 1) % n )) ;;
      '') CHOICE=$sel; break ;;
      q) CHOICE=-1; break ;;
    esac
    printf '\033[%dA' $((n + 1))
  done
  printf '\033[?25h'
}

menu() {
  local paths=() labels=() p wt slot list
  # The menu acts on one project: this one if configured, else the only one, else ask.
  if [ -z "$CONFIG" ] || [ "$(projects | grep -c .)" -gt 1 ]; then
    list="$(projects)"
    if [ "$(printf '%s' "$list" | grep -c .)" -gt 1 ]; then
      while read -r p; do paths+=("$p"); labels+=("$(basename "$p")"); done <<<"$list"
      clear_screen; choose "Which project?" "${labels[@]}"
      [ "$CHOICE" -lt 0 ] && return
      RAMIFY_ROOT="${paths[$CHOICE]}" "$SELF" menu; return
    fi
    [ -n "$list" ] && [ -z "$CONFIG" ] && { RAMIFY_ROOT="$list" "$SELF" menu; return; }
  fi
  while read -r p; do paths+=("$p"); done \
    < <(git -C "$PRIMARY" worktree list --porcelain | awk '/^worktree /{print $2}')
  for p in "${paths[@]}"; do
    wt="$(basename "$p")"; slot="$(envget "$STATE_DIR/$wt.env" SLOT)"
    labels+=("$(printf '%-40s %-8s %s' "$wt" "${slot:+slot $slot}" "$(branch_of "$p")")")
  done
  clear_screen
  choose "Which worktree?" "${labels[@]}" "Machine-wide cleanup" "Prune merged worktrees + branches"
  [ "$CHOICE" -lt 0 ] && return
  if [ "$CHOICE" = "${#paths[@]}" ]; then
    cleanup
  elif [ "$CHOICE" = "$((${#paths[@]} + 1))" ]; then
    prune; echo
    choose "Prune these?" "Prune" "Back"
    [ "$CHOICE" = 0 ] && prune --apply
  else
    p="${paths[$CHOICE]}"; echo
    choose "$(basename "$p")" "Start QA" "Stop + release slot" "Complete (close ticket, remove worktree)" "Force delete worktree + branch" "Back"
    case "$CHOICE" in
      0) RAMIFY_ROOT="$p" "$SELF" up ;;
      1) RAMIFY_ROOT="$p" "$SELF" down ;;
      2) echo; complete_tree "$p" ;;
      3) echo; force_delete "$p" ;;
      *) return ;;
    esac
  fi
  read -rsn1 -p "press any key to return to the dashboard"
}

# Redraws only when the rendered text changes: the text is the change detection.
watch_dash() {
  local interval="${1:-2}" prev='' now key hint='ctrl-c to stop'
  [ -t 0 ] && hint='m = menu · ctrl-c to stop'
  trap 'printf "\n"; exit 0' INT TERM
  while :; do
    now="$(dash 2>&1)"
    if [ "$now" != "$prev" ]; then
      clear_screen
      printf '%s\nwatching every %ss — %s   (last change %s)\n' "$now" "$interval" "$hint" "$(date +%H:%M:%S)"
      prev="$now"
    fi
    if [ -t 0 ]; then
      key=''; read -rsn1 -t "$interval" key
      [ "$key" = m ] && { menu; prev=''; }
    else
      sleep "$interval"
    fi
  done
}

show_config() { # [-q | get VAR]
  [ "${1:-}" = -q ] && { [ -n "$CONFIG" ]; return; }
  [ "${1:-}" = get ] && { [[ "${2:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && printf '%s\n' "${!2:-}"; return; }
  echo "config      ${CONFIG:-(none)}"
  echo "project     $RAMIFY_PROJECT   primary $PRIMARY"
  echo "worktree    $WORKTREE ($(branch_of "$REPO_ROOT"))"
  echo "main        $RAMIFY_REMOTE/$RAMIFY_MAIN   new trees in $RAMIFY_WORKTREES, branches '$RAMIFY_BRANCH_PREFIX<slug>'"
  echo "services    ${RAMIFY_SERVICES:-(none)}"
  echo "qa plan     ${RAMIFY_QA_PLAN:-(none)}"
  echo "jira        ${RAMIFY_JIRA_URL:-(none)}${RAMIFY_JIRA_URL:+   tickets matching $RAMIFY_TICKET_PATTERN}"
  echo "state       $STATE_DIR"
  [ -n "$CONFIG" ]
}

case "${1:-}" in
  setup) exec "$RAMIFY_HOME/libexec/setup.sh" "$PRIMARY" "${@:2}" ;;
  new) new "${2:-}" ;;
  label) label "${2:-}" ;;
  config) show_config "${2:-}" "${3:-}" ;;
  up) up ;;
  down) down ;;
  ping) ping ;;
  card) need_config; tile "$WORKTREE" smoke ;;
  dash) [ "${2:-}" = --json ] && dash_json || dash ;;
  dash-project) [ "${2:-}" = --json ] && dash_project_json || dash_project ;;
  menu) need_config any; menu ;;
  watch) watch_dash "${2:-2}" ;;
  status) status ;;
  cleanup) cleanup ;;
  prune) prune "${2:-}" ;;
  delete) force_delete "${2:-}" "${3:-}" ;;
  complete) complete_tree "${2:-}" "${3:-}" ;;
  jira)
    need_config any
    case "${2:-}" in
      login) jira_login ;;
      check) [ -n "$RAMIFY_JIRA_URL" ] || die "no RAMIFY_JIRA_URL in $CONFIG"; jira check ;;
      *) die "usage: ramify jira login | check" ;;
    esac ;;
  shared-down) shared_down ;;
  *) sed -n '3,8p' "$SELF" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
