{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" behind",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" pr-gate",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" decide-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" human-gate",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" workflow-pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" push",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" worktree-add",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" auto-gate",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" workflow-post",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RAMIFY_AGENT=codex \"${PLUGIN_ROOT}/hooks/ramify-hook\" session-end",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
